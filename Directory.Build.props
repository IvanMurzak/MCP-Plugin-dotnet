<Project>

  <!-- Fail restore on any known-vulnerable package (direct or transitive) at moderate or
       above (NU1902 moderate, NU1903 high, NU1904 critical), so an advisory such as
       GHSA-334f-vvp4-7g6p cannot ship again unnoticed in the published packages.
       Package versions are set per project: McpPlugin / McpPlugin.Common stay on the
       netstandard2.1-compatible SignalR 8.0.x line, McpPlugin.Server uses 10.0.x. -->
  <PropertyGroup>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>moderate</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

</Project>

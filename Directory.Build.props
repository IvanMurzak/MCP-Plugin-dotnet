<Project>

  <!-- TEMPORARY pre-release feed: ReflectorNet is integrated unreleased as a -dev package committed under
       prerelease-packages/ (com.IvanMurzak.ReflectorNet 5.5.1-dev.ec3702e: nullable parameters without a default
       are not required in tool input schemas). Before a release: pin a published ReflectorNet, delete
       prerelease-packages/, this property, the .gitignore exception and the Dockerfile.local COPY lines.

       (History: this file used to be intentionally empty after the v8/v10 Microsoft.Extensions pins it held were
       dropped together with the MCP dependency of McpPlugin and McpPlugin.Common.) -->
  <PropertyGroup>
    <RestoreAdditionalProjectSources>$(RestoreAdditionalProjectSources);$(MSBuildThisFileDirectory)prerelease-packages</RestoreAdditionalProjectSources>
  </PropertyGroup>

</Project>
